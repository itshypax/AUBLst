Options -Indexes
RewriteEngine On
RewriteRule ^frontend(?:/(.*))?$ /$1 [R=308,L,NE]

# Der Alarmmonitor liegt unter /monitor, ausgeliefert wird dieselbe Seite.
# Ohne Schrägstrich am Ende, sonst sucht die Seite ihre Dateien unter /monitor/.
# Ziel ist der angefragte Pfad selbst: Ein relatives Ziel bekäme den Dateipfad
# (/var/www/html/...) vorangestellt, ein festes /monitor bräche Unterordner.
RewriteCond %{REQUEST_URI} ^(.+)/$
RewriteRule ^monitor/$ %1 [R=308,L,NE]
RewriteRule ^monitor$ index.html [L]

<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css|webp|png|jpg|jpeg|svg|woff2|mp3|m4a|wav)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  <FilesMatch "^(?:index\.html|manifest\.webmanifest|sw\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
